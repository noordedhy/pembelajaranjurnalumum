# ---------------------------------------------------------------
# Keamanan folder upload: matikan eksekusi PHP & skrip lain.
# Hanya file statis (gambar/video) yang boleh disajikan.
# ---------------------------------------------------------------

# Apache 2.3+: tolak semua handler, sajikan sebagai teks biasa
ForceType text/plain
SetHandler None

# Matikan engine PHP (Apache + mod_php)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# cgi/fcgi/suexec — blokir akses langsung ke file skrip
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|pht|phar|pl|py|jsp|asp|aspx|sh|cgi|htaccess)$">
    Require all denied
</FilesMatch>

# Jangan izinkan listing direktori
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pht .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .pht .phar
